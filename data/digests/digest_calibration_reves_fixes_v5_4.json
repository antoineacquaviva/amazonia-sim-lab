s_id":5,"studio_config_index_192":161,"profil_piste":"P5_12223","regle_ouverture_reve_multiple":"UNIQUE_PAR_TOUR","offset_seuil_parade":0,"placement_initial_machines":"MEME_PARCELLE_P1","role_abatteuse_fin_de_piste":"STANDARD_COUPE_ARBRE","synergie_binome_machines":"INDIVIDUELLE"}],"tactiques":[{"id":"T1","nom":"Sur place","cibles":["SUR_PLACE"],"avancee":0,"gain_rouge":0,"mod_seuil":0,"est_ratissage_profil":true},{"id":"T2","nom":"Devant","cibles":["DEVANT"],"avancee":0,"gain_rouge":0,"mod_seuil":0,"est_ratissage_profil":false},{"id":"T3","nom":"En avançant","cibles":["SUR_PLACE","DEVANT"],"avancee":1,"gain_rouge":0,"mod_seuil":-1,"est_ratissage_profil":false},{"id":"T4","nom":"Sur place +","cibles":["SUR_PLACE"],"avancee":0,"gain_rouge":1,"mod_seuil":-1,"est_ratissage_profil":false},{"id":"T5","nom":"Devant +","cibles":["DEVANT"],"avancee":0,"gain_rouge":1,"mod_seuil":-1,"est_ratissage_profil":false},{"id":"T6","nom":"En avançant +","cibles":["SUR_PLACE","DEVANT"],"avancee":1,"gain_rouge":1,"mod_seuil":-2,"est_ratissage_profil":false}],"machine_damage_rules":{"ABATTEUSE":{"arbres_coupes_max":2,"souches_retirees":0,"arrache_1_souche_si_sans_arbre_en_ratissage_option":"ARRACHE_1_SOUCHE_SI_SANS_ARBRE"},"BULLDOZER":{"arbres_coupes_max":1,"retire_toutes_souches_non_protegees":true,"test_parade_unique":true},"ratissage":{"pion_double_face":true,"bonus_puissance_imprime":1,"traite_comme_jeton_rouge_a_tous_egards":true,"conserve_jetons_puissance_anterieurs":true,"tactique_imprimee":"T1","piste_tactiques_fixe":true,"entree_definitive_derniere_parcelle":true}},"machine_deck_rules":{"cartes_machine_par_rayon":2,"types_par_rayon":["ABATTEUSE","BULLDOZER"],"total_initial_formula":"2 * N","sabotage_dilution_permanente":true,"sabotage_effet_propre":null,"sabotage_perd_activation_et_pas_de_des":true,"remelange_etape":"6.3","penurie_ordre":"sens_horaire_depuis_plus_arbres_debout"},"spec_formelle":{"schema_version":"5.4.2","etapes_1_a_6":{"etape_1_PREPARATION_ET_DES_SECRETS":"Ratissage, Distribution et Dés secrets (1.1–1.3) : Lecture épurée des dés sous paravent : seul un joueur ayant tiré une carte Machine retient M = min(D1, D2) (ou max sous Loi). Si le rang M porte un Rêve en 3.2, la machine est annulée et le Rêve s’ouvre. Communication muette : silence tactique sous paravent fermé ; simple visibilité publique sans concertation orale sous l'Ara.","etape_2_POSE_DES_DEFENSEURS":"Pose des Défenseurs et Piste de Furtivité (2.1–2.2) : Furtivité à 4 emplacements (2 jumeaux/rive) : entrer sur la case tire l'autre jeton sur le jumeau et oriente l'action unique ; retourner en choix définitif se fait sur place sans déplacement.","etape_3_CONSTRUCTION_ET_REVELATION":"Construction obligatoire (3.1), Ouverture des Paravents et Rêves (3.2) : Gouvernance unitaire : chaque tuile de Synergie et piste de Migration est décidée uniquement par son Peuple d'origine. Piste des Tactiques fixe (T1..T6 imprimées en dur) et placement des Rêves (v5.4.2) : aucune tuile Tactique mobile ni éjection de Tactique. Un Rêve construit en 3.1 se pose par-dessus la case libre la plus à droite (6, puis 5, etc.). Les Insectes Bug restent sur leur numéro d'emplacement imprimé. Activation et avancée des Rêves (v5.4.2) : en 2.2, un joueur peut poser son 2e Défenseur sur un Rêve déjà présent sur la piste (immobilisé jusqu'au ménage de fin de tour). En 3.2, selon le mode actif (Option A par défaut : 1 Défenseur annule 1 carte Machine sur ce rang M en priorisant la plus menaçante ; Option B : >=1 Défenseur annule tout le rang ; Option C : binôme >=2 Défenseurs annule tout le rang), toute machine non annulée exécute la Tactique T1..T6 imprimée sous la case. Dès qu'au moins 1 machine est annulée, le Rêve s'ouvre (max 1 ouverture/tour par défaut) et avance d'1 cran vers la gauche en sautant/poussant tout bloc contigu de Rêves vers la première case libre à sa gauche (plafonné au Rang 1). Rêve sur dé Machine : annule l'activation de la machine et peut ouvrir ce Rêve (max 1 ouverture par Rêve et par tour).","etape_4_FURTIVITE_NIDS_ET_MIGRATION":"Furtivité (4.1), Production des Nids (4.2) et Migration des Insectes (4.3) : Cartes Sabotage (dilution permanente) : toutes identiques et sans effet propre (réserve illimitée). 1 Sabotage acquis ajoute définitivement 1 carte Sabotage au paquet Machine (allume 3. Sabotage) ; 1 carte Sabotage tirée à l’Étape 1 fait perdre 1 activation au Contremaître puis est remélangée en fin de tour. Production des Nids : bloc indivisible (création selon état réel présent + pouvoir du Nid avant Gardiens) ; Miel des Ancêtres restreint aux jetons Insecte. Migration des Insectes : 0 ou 1 cran facultatif (suivi par retournement des pions) ; aller simple définitif et sans limite vers les pistes globales.","etape_5_ATTAQUES_ET_TEST_FIN":"Attaques des Machines et Vérification de Fin de Partie (5.1–5.3) : Séquence des attaques : Tactiques 1..6 puis Ratissages ; Abatteuse avant Bulldozer sur un même rayon, libre entre rayons distincts ; machine résolue d'un seul tenant. Cibles dynamiques : lues selon la position physique réelle de la machine à l’instant où elle attaque. Pont routier : Routes Forestières systématiquement sautées le long d'un rayon, mais infranchissables/inoccupables latéralement. Repli sur création de Route : recul automatique vers la bordure par défaut, vers le cœur seulement si bord tout rasé, retrait si rayon tout rasé ; Ratissage irréversible maintenu. Contact Machine-Nid : tout mouvement entrant (avancée, recul, repli) renvoie le Nid reconstructible en lisière et défausse tous les Insectes de la parcelle.","etape_6_APPRENTISSAGE_ET_MENAGE":"Ménage de fin de tour (6.2–6.3) : Cascades de Gardiens : fin complète de l'effet en cours, marquage immédiat à l'ouverture, balayage à plat de 1 à 6 sans pile imbriquée. Faces 2 et Lois passives : seule la face visible s'applique (Faces 2 autonomes) ; une Loi passive reçoit automatiquement son marqueur dès que sa case s'allume."},"furtivite":"Furtivité à 4 emplacements (2 jumeaux/rive) : entrer sur la case tire l'autre jeton sur le jumeau et oriente l'action unique ; retourner en choix définitif se fait sur place sans déplacement.","chaine_parades_et_pieges":"Matamata et chaîne des parades : Matamata vérifie la présence d'une Souche à chaque frappe ; ordre Jaguar -> Harpie -> Piège -> Parade classique. | Armement des Pièges : Embuscade dès que Défense totale >= 1 (locale ou à distance) ; tout Piège ayant paré >= 1 fois dans le tour est retiré en fin d'attaques. | Parade classique sans dette : défausse immédiate à la frappe des Insectes requis ; suppression totale des Insectes engagés. | Zéro verrouillage des parcelles ciblées : Insectes toujours libres tant que présents ; seul un Piège déjà déclenché ce tour-ci ne peut plus payer de coût volontaire.","sabotage_par_dilution":"Cartes Sabotage (dilution permanente) : toutes identiques et sans effet propre (réserve illimitée). 1 Sabotage acquis ajoute définitivement 1 carte Sabotage au paquet Machine (allume 3. Sabotage) ; 1 carte Sabotage tirée à l’Étape 1 fait perdre 1 activation au Contremaître puis est remélangée en fin de tour.","piste_tactiques_fixe_et_reves":"Piste des Tactiques fixe (T1..T6 imprimées en dur) et placement des Rêves (v5.4.2) : aucune tuile Tactique mobile ni éjection de Tactique. Un Rêve construit en 3.1 se pose par-dessus la case libre la plus à droite (6, puis 5, etc.). Les Insectes Bug restent sur leur numéro d'emplacement imprimé. | Activation et avancée des Rêves (v5.4.2) : en 2.2, un joueur peut poser son 2e Défenseur sur un Rêve déjà présent sur la piste (immobilisé jusqu'au ménage de fin de tour). En 3.2, selon le mode actif (Option A par défaut : 1 Défenseur annule 1 carte Machine sur ce rang M en priorisant la plus menaçante ; Option B : >=1 Défenseur annule tout le rang ; Option C : binôme >=2 Défenseurs annule tout le rang), toute machine non annulée exécute la Tactique T1..T6 imprimée sous la case. Dès qu'au moins 1 machine est annulée, le Rêve s'ouvre (max 1 ouverture/tour par défaut) et avance d'1 cran vers la gauche en sautant/poussant tout bloc contigu de Rêves vers la première case libre à sa gauche (plafonné au Rang 1).","fins_5_3":"Réveil de la Forêt (v5.4.1) : actif uniquement si au moins 1 Peuple Animal Sauvage (M, R ou O) est autour de la table. Éveil universel Face 1 -> Face 2 à l'ouverture d'un Gardien (y compris monofaces et Mode 2 neutre ; G14:C éligible sur Face 2 Rassasié). En 2.2 (2e Défenseur), les joueurs peuvent cibler un Gardien Face 2 (max 1 Gardien engagé/tour) : si le quota Q est atteint en choix définitif, le Gardien est retiré de la piste (pouvoir/Loi inactifs ce tour, case 1..6 libre dès 3.1) ; sinon les Défenseurs orphelins restent sans effet. En 5.3, déclenchement immédiat du Réveil si 0 dommage réel ce tour (aucun Arbre coupé ni Souche retirée) ; en cas d'échec, résolution du sort du Gardien en 6.3 (retour lisière Face 1 ou retrait définitif). Les marqueurs « utilisé » des cases 1..6 servent uniquement à l'ouverture unique/tour, aux cascades 1->6, à la Résonance 4 et aux Lois passives. | Test de fin de partie : vérification unique en fin d’attaques (5.3, passage direct à la Repousse Finale) sur Tour 8, Réveil de la Forêt (Gardien Face 2 engagé au quota Q en 2.2 et 0 dommage réel subi ce tour) ou Sommeil du Contremaître (toutes les tuiles Rêves en jeu regroupées en bloc continu à gauche cases 1..k de la Piste des Tactiques)."}},"tested_tiles_rules":[],"description":"Calibration Mode 2 v5.4.2 : Piste des Tactiques fixe T1..T6, purge Apprentissage 6.1, SLOT_BUG_CERVEAU=B, activation des Rêves en 2.2 (Options A/B/C), bot B2, N=3..6, toutes combinaisons de Peuples (0, 1 et 2 Peuples Oniriques), 6 profils de piste canoniques.","selection_manifest":{"base_bundle_id":"STANDARD_A","n_resolved_slots":32,"non_default_base_slots":{"SLOT_BUG_CERVEAU":"B"},"resolved_32_slots_sha256":"73edb6fedb7d3baf04e5d47493e1e72ba79b5ff6110a9a016a3717b638be7d91","migration_policy":{"SLOT_BUG_CERVEAU":"B","SLOT_COLONIS