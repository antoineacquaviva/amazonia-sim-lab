,"studio_config_index_192":161,"profil_piste":"P5_12223","regle_ouverture_reve_multiple":"UNIQUE_PAR_TOUR","offset_seuil_parade":0,"placement_initial_machines":"MEME_PARCELLE_P1","role_abatteuse_fin_de_piste":"STANDARD_COUPE_ARBRE","synergie_binome_machines":"INDIVIDUELLE"}],"tactiques":[{"id":"T1","nom":"Sur place","cibles":["SUR_PLACE"],"avancee":0,"gain_rouge":0,"mod_seuil":0,"est_ratissage_profil":true},{"id":"T2","nom":"Devant","cibles":["DEVANT"],"avancee":0,"gain_rouge":0,"mod_seuil":0,"est_ratissage_profil":false},{"id":"T3","nom":"En avançant","cibles":["SUR_PLACE","DEVANT"],"avancee":1,"gain_rouge":0,"mod_seuil":-1,"est_ratissage_profil":false},{"id":"T4","nom":"Sur place +","cibles":["SUR_PLACE"],"avancee":0,"gain_rouge":1,"mod_seuil":-1,"est_ratissage_profil":false},{"id":"T5","nom":"Devant +","cibles":["DEVANT"],"avancee":0,"gain_rouge":1,"mod_seuil":-1,"est_ratissage_profil":false},{"id":"T6","nom":"En avançant +","cibles":["SUR_PLACE","DEVANT"],"avancee":1,"gain_rouge":1,"mod_seuil":-2,"est_ratissage_profil":false}],"machine_damage_rules":{"ABATTEUSE":{"arbres_coupes_max":2,"souches_retirees":0,"arrache_1_souche_si_sans_arbre_en_ratissage_option":"ARRACHE_1_SOUCHE_SI_SANS_ARBRE"},"BULLDOZER":{"arbres_coupes_max":1,"retire_toutes_souches_non_protegees":true,"test_parade_unique":true},"ratissage":{"pion_double_face":true,"bonus_puissance_imprime":1,"traite_comme_jeton_rouge_a_tous_egards":true,"conserve_jetons_puissance_anterieurs":true,"tactique_imprimee":"T1","piste_tactiques_fixe":true,"entree_definitive_derniere_parcelle":true}},"machine_deck_rules":{"cartes_machine_par_rayon":2,"types_par_rayon":["ABATTEUSE","BULLDOZER"],"total_initial_formula":"2 * N","sabotage_dilution_permanente":true,"sabotage_effet_propre":null,"sabotage_perd_activation_et_pas_de_des":true,"remelange_etape":"6.3","penurie_ordre":"sens_horaire_depuis_plus_arbres_debout"},"spec_formelle":{"schema_version":"5.4.7","etapes_1_a_6":{"etape_1_PREPARATION_ET_DES_SECRETS":"Ratissage, Distribution et Dés secrets (1.1–1.3) : Lecture épurée des dés sous paravent : seul un joueur ayant tiré une carte Machine retient M = min(D1, D2) (ou max sous Loi). Si le rang M porte un Rêve en 3.2, la machine est annulée et le Rêve s’ouvre. Pari d'activation sur les Gardiens & Partition stricte des 6 déclencheurs (v5.4.7) : actif si >= 1 Peuple Animal Sauvage (M/R/O) est à la table. Plafond uniforme UNIFORM_MAX_2 (max 2 Défenseurs par Gardien construit cases 1..6 ; 0 = inactif). Partition stricte (« 1 événement = au plus 1 déclencheur ») : 3.2 (Sabotage > Insecte Bug > Rêve) ; 4.1 sans déclencheur 2/3 ; la production d'un Nid en 4.2 n'allume jamais 6. Insecte ; 5.1/5.2 (Piégeage > Insecte Parade >=1 Insecte > Parade Défenseurs seuls) ; 4. Gardien verrouillée sur DISTINCT_OPEN_1 (anti-boucle conservé : 1re ouverture du tour de chaque autre Gardien distinct). En 5.3 : 0 Défenseur restant -> pari gagné (reste en piste, passe Face 2 en Mode 4 si double-face) ; >= 1 Défenseur restant -> pari perdu (retour en lisière Face 1, sauf Bouclier de lisière SLOT_COLONISATION_GARDIENS=B qui défausse 1 Insecte de la case pour garder la tuile sur sa face actuelle, le pari restant PERDU).","etape_2_POSE_DES_DEFENSEURS":"Pose des Défenseurs et Piste de Furtivité (2.1–2.2) : Furtivité à 4 emplacements (2 jumeaux/rive) : entrer sur la case tire l'autre jeton sur le jumeau et oriente l'action unique ; retourner en choix définitif se fait sur place sans déplacement.","etape_3_CONSTRUCTION_ET_REVELATION":"Construction obligatoire (3.1), Ouverture des Paravents et Rêves (3.2) : Gouvernance unitaire : chaque tuile de Synergie et piste de Migration est décidée uniquement par son Peuple d'origine. Piste des Tactiques fixe (T1..T6 imprimées en dur) et placement des Rêves (v5.4.2) : aucune tuile Tactique mobile ni éjection de Tactique. Un Rêve construit en 3.1 se pose par-dessus la case libre la plus à droite (6, puis 5, etc.). Les Insectes Bug restent sur leur numéro d'emplacement imprimé. Activation et avancée des Rêves (v5.4.6) : en 2.2, un joueur peut poser son Défenseur sur un Rêve déjà présent sur la piste fixe T1..T6 (coût d'activation indépendant de l'Éveil). En 3.2 (Option A : 1_DEF_1_MACHINE), chaque Défenseur posé sur un Rêve annule 1 machine pointant sur ce rang M (en priorisant la plus menaçante) ; toute machine non annulée exécute la Tactique T1..T6 imprimée sous la case. Dès qu'au moins 1 machine est annulée, le Rêve s'ouvre et avance vers la gauche (par saut/poussée vers la 1re case libre à gauche) en mode CLEAR_RANK_ONLY uniquement si TOUTES les machines de ce rang M ont été annulées ce tour-ci. Déclencheur 5. Rêve (partition stricte 3.2) : s'allume pour chaque carte Machine non déviée par un Bug dont le dé retenu M pointe sur un rang occupé par un Rêve (que la machine soit annulée ou joue la Tactique dessous). Rêve sur dé Machine : annule l'activation de la machine et peut ouvrir ce Rêve (max 1 ouverture par Rêve et par tour).","etape_4_FURTIVITE_NIDS_ET_MIGRATION":"Furtivité (4.1), Production des Nids (4.2) et Migration des Insectes (4.3) : Cartes Sabotage (dilution permanente, v5.4.6) : toutes identiques et sans effet propre (réserve illimitée). 1 Sabotage acquis en Furtivité 4.1 ajoute définitivement 1 carte Sabotage au paquet Machine en 6.3 (n'allume plus 3. Sabotage à l'acquisition) ; 1 carte Sabotage révélée à l'ouverture des paravents en 3.2 fait perdre 1 activation au Contremaître, allume 3. Sabotage (partition stricte 3.2), puis est remélangée en fin de tour. Production des Nids : bloc indivisible (création selon état réel présent + pouvoir du Nid avant Gardiens) ; Miel des Ancêtres restreint aux jetons Insecte. Migration des Insectes : 0 ou 1 cran facultatif (suivi par retournement des pions) ; aller simple définitif et sans limite vers les pistes globales.","etape_5_ATTAQUES_ET_TEST_FIN":"Attaques des Machines et Vérification de Fin de Partie (5.1–5.3) : Séquence des attaques : Tactiques 1..6 puis Ratissages ; Abatteuse avant Bulldozer sur un même rayon, libre entre rayons distincts ; machine résolue d'un seul tenant. Cibles dynamiques : lues selon la position physique réelle de la machine à l’instant où elle attaque. Pont routier : Routes Forestières systématiquement sautées le long d'un rayon, mais infranchissables/inoccupables latéralement. Repli sur création de Route : recul automatique vers la bordure par défaut, vers le cœur seulement si bord tout rasé, retrait si rayon tout rasé ; Ratissage irréversible maintenu. Contact Machine-Nid : tout mouvement entrant (avancée, recul, repli) renvoie le Nid reconstructible en lisière et défausse tous les Insectes de la parcelle.","etape_6_APPRENTISSAGE_ET_MENAGE":"Ménage de fin de tour (6.2–6.3) : Cascades de Gardiens : fin complète de l'effet en cours, marquage immédiat à l'ouverture, balayage à plat de 1 à 6 sans pile imbriquée. Faces 2 et Lois passives : seule la face visible s'applique (Faces 2 autonomes) ; une Loi passive reçoit automatiquement son marqueur dès que sa case s'allume."},"furtivite":"Furtivité à 4 emplacements (2 jumeaux/rive) : entrer sur la case tire l'autre jeton sur le jumeau et oriente l'action unique ; retourner en choix définitif se fait sur place sans déplacement.","chaine_parades_et_pieges":"Matamata et chaîne des parades : Matamata vérifie la présence d'une Souche à chaque frappe ; ordre Jaguar -> Harpie -> Piège -> Parade classique. | Armement des Pièges : Embuscade dès que Défense totale >= 1 (locale ou à distance) ; tout Piège ayant paré >= 1 fois dans le tour est retiré en fin d'attaques. | Parade classique sans dette : défausse immédiate à la frappe des Insectes requis ; suppression totale des Insectes engagés. | Zéro verrouillage des parcelles ciblées : Insectes toujours libres tant que présents ; seul un Piège déjà déclenché ce tour-ci ne peut plus payer de coût volontaire.","sabotage_par_dilution":"Cartes Sabotage (dilution permanente, v5.4.6) : toutes identiques et sans effet propre (réserve illimitée). 1 Sabotage acquis en Furtivité 4.1 ajoute définitivement 1 carte Sabotage au paquet Machine en 6.3 (n'allume plus 3. Sabotage à l'acquisition) ; 1 carte Sabotage révélée à l'ouverture des paravents en 3.2 fait perdre 1 activation au Contremaître, allume 3. Sabotage (partition stricte 3.2), puis est remélangée en fin de tour.","piste_tactiques_fixe_et_reves":"Piste des Tactiques fixe (T1..T6 imprimées en dur) et placement des Rêves (v5.4.2) : aucune tuile Tactique mobile ni éjection de Tactique. Un Rêve construit en 3.1 se pose par-dessus la case libre la plus à droite (6, puis 5, etc.). Les Insectes Bug restent sur leur numéro d'emplacement imprimé. | Activation et avancée des Rêves (v5.4.6) : en 2.2, un joueur peut poser son Défenseur sur un Rêve déjà présent sur la piste fixe T1..T6 (coût d'activation indépendant de l'Éveil). En 3.2 (Option A : 1_DEF_1_MACHINE), chaque Défenseur posé sur un Rêve annule 1 machine pointant sur ce rang M (en priorisant la plus menaçante) ; toute machine non annulée exécute la Tactique T1..T6 imprimée sous la case. Dès qu'au moins 1 machine est annulée, le Rêve s'ouvre et avance vers la gauche (par saut/poussée vers la 1re case libre à gauche) en mode CLEAR_RANK_ONLY uniquement si TOUTES les machines de ce rang M ont été annulées ce tour-ci. Déclencheur 5. Rêve (partition stricte 3.2) : s'allume pour chaque carte Machine non déviée par un Bug dont le dé retenu M pointe sur un rang occupé par un Rêve (que la machine soit annulée ou joue la Tactique dessous).","fins_5_3":"Éveil de la Forêt 100 % Piste des Gardiens (v5.4.7) : actif uniquement si au moins 1 Peuple Animal Sauvage (M, R ou O) est autour de la table, aux Tours 1..7 (priorité absolue à Tour 8). En 5.3, la Forêt s'éveille si les N Défenseurs de la table ont tous été engagés en 2.2 sur la Piste des Gardiens et qu'aucun pari n'est perdu (0 Défenseur restant sur la Piste des Gardiens). Un Gardien sauvé par Bouclier de lisière (SLOT_COLONISATION_GARDIENS=B) reste en piste mais son pari reste PERDU (ne compte pas pour l'Éveil). | Test de fin de partie (5.3) : priorité absolue à Tour 8 (au Tour 8, la fin est toujours TOUR_8) ; sur les Tours 1..7, vérification directe après issue des paris Gardiens (et Bouclier de lisière éventuel) de Sommeil du Contremaître (toutes les tuiles Rêves en jeu en bloc continu à gauche cases 1..k de la Piste des Tactiques) ou d'Éveil de la Forêt 100 % Gardiens (les N Défenseurs de la table engagés en 2.2 sur la Piste des Gardiens et 0 Défenseur restant en 5.3). Passage direct à la Repousse Finale."}},"tested_tiles_rules":[],"description":"Validation du socle Mode 2 v5.4.7 : partition stricte des 6 déclencheurs (4.2 Nids retiré de 6. Insecte ; 6. Insecte exclusivement en 3.2 Bug ou 5.1 Parade avec dépense >= 1 Insecte), case 4. Gardien verrouillée sur DISTINCT_OPEN_1, Bouclier de lisière SLOT_COLONISATION_GARDIENS=B, et politique B2 corrigée (valorisation réaliste Sabotage 4.1 + arbitrage Migration 4.3 forêt / Bug / Bouclier). Mode 2, bot B2, N=3..6, toutes combinaisons de Peuples avec A >= 1 Animal Sauvage, 6 châssis canoniques (chassis_id 0..5), 5 760 parties.","selection_manifest":{"base_bundle_id":"STANDARD_A","n_resolved_slots":32,"non_default_base_slots":{"SLOT_BUG_CERVEAU":"B","SLOT_COLONISATION_GARDIENS":"B"},"resolved_32_slots_sha256":"d349f4347c0e33c76213ad2cb0a129acf1d9df2f9432543346cf5f92dee48771","migration_policy":{"SLOT_BUG_CERVEAU":"B","SLOT_COLONISATION_GARDIENS":"B","fixed":true,"varying_slots":[]}},"execution":{"backend":"cloudrun","region":"europe-west9","job_name":"amazonia-campaign","image":"europe-west9-docker.pkg.dev/amazonia-sim/sim-workers/worker-pypy:latest","tasks":10,"seed":20261125,"job_wall_sec":40.25,"max_worker_compute_sec":27.325,"sum_worker_games_per_sec":283.3,"effective_cluster_games_per_sec":210.8,"run_id":"20261120T231140Z_e473dbce","gcs_prefix":"campaigns/validation_socle_v5_5/20261120T231140Z_e473dbce"},"totals":{"total_games":5760,"n_shards":10,"n_cells":246,"n_configurations